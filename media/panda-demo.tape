Output media/panda-demo.gif
Set Shell zsh
Set Theme "Catppuccin Mocha"
Set Width 1280
Set Height 740
Set FontSize 16
Set Padding 18
Set Framerate 15
Set PlaybackSpeed 4
Env PS1 "$ "
Hide
Type 'cd "$(git rev-parse --show-toplevel)" && clear' Enter
Show
Type "./demo" Enter
Wait+Screen@900s /on car bus/
Sleep 12s
